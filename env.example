# Copy to `.env` and fill in. Expo loads EXPO_PUBLIC_* automatically.
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000/api

# Local Node API (`server/`): npm install && npm start — from repo root: node server/index.js
# PORT=4000
# API_PUBLIC_URL=http://192.168.1.100:4000
# JWT_SECRET=change-me-in-production
# PAYMENT_STUB_REDIRECT=https://example.com

# Stripe — publishable key ONLY (pk_test_... / pk_live_...). Secret keys (sk_...) must stay on your server.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_PAYMENTS_STRIPE_ENABLED=false

# Easypaisa — public store id; signing secrets on server only.
EXPO_PUBLIC_PAYMENTS_EASYPAISA_ENABLED=false
EXPO_PUBLIC_EASYPAISA_STORE_ID=

# JazzCash — public merchant id; API password/hash on server only.
EXPO_PUBLIC_PAYMENTS_JAZZCASH_ENABLED=false
EXPO_PUBLIC_JAZZCASH_MERCHANT_ID=

# Optional: override POST paths (default /payments/stripe/checkout-session, etc.)
# EXPO_PUBLIC_PAYMENT_STRIPE_SESSION_PATH=/payments/stripe/checkout-session
# EXPO_PUBLIC_PAYMENT_EASYPAISA_SESSION_PATH=/payments/easypaisa/session
# EXPO_PUBLIC_PAYMENT_JAZZCASH_SESSION_PATH=/payments/jazzcash/session

# Wallet: minimum balance to place a bid is 1000 PKR (see src/constants/walletRules.js; server mirrors in server/routes/listings.js).

# Firebase migration (optional): see firebase/README.md and firebase/functions/.env.example — use Cloud Functions for top-ups and Firestore for wallet_balance + transactions.
