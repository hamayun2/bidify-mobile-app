# =============================================================================
# Bidify API server — copy to `server/.env` and fill in values, then:
#   cd server
#   npm install
#   npm start
# =============================================================================

PORT=4000

# Public URL of THIS server (no /api suffix). Stripe redirect URLs use this.
# Use your PC LAN IP when testing on a real phone: http://192.168.x.x:4000
API_PUBLIC_URL=http://localhost:4000

# Required for wallet top-up auth (Express JWT)
JWT_SECRET=YOUR_JWT_SECRET_MIN_32_CHARS

# Mirror Stripe top-ups → public.profiles.wallet_balance (Dashboard → Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Stripe TEST mode only — Dashboard → Developers → API keys → Secret key (sk_test_...)
STRIPE_TEST_SECRET_KEY=YOUR_STRIPE_TEST_SECRET_KEY
STRIPE_TEST_PUBLISHABLE_KEY=YOUR_STRIPE_TEST_PUBLISHABLE_KEY

# Optional: Stripe CLI webhook forwarding (stripe listen --forward-to localhost:4000/payments/stripe/webhook)
# Copy from root .env or Stripe CLI: stripe listen --forward-to localhost:4000/api/payments/stripe/webhook
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET_OPTIONAL

# Required to credit public.profiles.wallet_balance after Stripe top-up
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Deep link after payment in browser
PAYMENT_RETURN_URL=bidify://wallet

# Optional admin email override for Express admin routes
EXPO_PUBLIC_ADMIN_EMAIL=admin@bidify.com

# Google Cloud Vision — CNIC OCR (POST /api/profile/scan-cnic)
# Create key: Google Cloud Console → APIs & Services → Credentials → API key (enable Vision API)
GOOGLE_VISION_API_KEY=PASTE_YOUR_API_KEY_HERE
