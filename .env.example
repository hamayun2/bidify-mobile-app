# =============================================================================
# Bidify — copy this file to `.env` in the project root, fill in values, then:
#   npx expo start --clear
# =============================================================================

# --- Supabase (auth, profiles, listings) ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- Google Sign-In (native dev build; not Expo Go) ---
# Web OAuth client ID — also paste into Supabase Auth → Google provider
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
# iOS reversed client ID for Expo plugin (com.googleusercontent.apps.…)
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.YOUR_NUMERIC_SUFFIX
# Server-side seed script only (never in client bundle)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Built-in admin (optional overrides) ---
EXPO_PUBLIC_BUILTIN_ADMIN_EMAIL=admin@bidify.com
EXPO_PUBLIC_BUILTIN_ADMIN_PASSWORD=admin1234

# --- Express API (wallet, Stripe, chat) — MUST end with /api ---
# Same PC + Android emulator:  http://10.0.2.2:4000/api  (auto from localhost on Android)
# Same PC + physical phone:    http://YOUR_PC_LAN_IP:4000/api  (run ipconfig — Wi-Fi IPv4, e.g. 192.168.1.10)
#   OR keep localhost below and set EXPO_PUBLIC_API_DEV_HOST to that LAN IP
# Expo web on same PC:         http://localhost:4000/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api
# Optional: rewrite localhost → LAN IP on real devices (find IP: ipconfig on Windows)
EXPO_PUBLIC_API_DEV_HOST=192.168.1.10

# --- Stripe (Payment Sheet + checkout) — Dashboard → API keys → Publishable (pk_test_...) ---
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_TEST_PUBLISHABLE_KEY

# --- Google Gemini (Bidify AI chatbot on Help & Support) ---
# Get a key: https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# --- Payment UI toggles ---
EXPO_PUBLIC_PAYMENTS_STRIPE_ENABLED=true
EXPO_PUBLIC_PAYMENTS_EASYPAISA_ENABLED=true
EXPO_PUBLIC_PAYMENTS_JAZZCASH_ENABLED=true

# --- Server secrets (also used when you run `npm run api` from root) ---
PORT=4000
# Use LAN IP when testing wallet/Stripe from a physical phone (same as API URL host)
# Must match a real LAN IP on this PC (not an old DHCP address) — used for Stripe return URLs
API_PUBLIC_URL=http://192.168.1.10:4000
JWT_SECRET=YOUR_JWT_SECRET_MIN_32_CHARS
STRIPE_TEST_SECRET_KEY=YOUR_STRIPE_TEST_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET_OPTIONAL
PAYMENT_RETURN_URL=bidify://wallet

# Google Cloud Vision — CNIC OCR (used by Express when running npm run api)
GOOGLE_VISION_API_KEY=PASTE_YOUR_API_KEY_HERE
